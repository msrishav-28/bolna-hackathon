{
  "name": "samvaad",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3013",
    "gateway:build": "tsc -p gateway/tsconfig.json",
    "gateway:start": "node --env-file-if-exists=.env.local .gateway/gateway/main.js",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests gateway public/audio package.json tsconfig.json eslint.config.mjs postcss.config.mjs vitest.config.ts next.config.ts scripts",
    "format:check": "prettier --check src tests gateway public/audio package.json tsconfig.json eslint.config.mjs postcss.config.mjs vitest.config.ts next.config.ts scripts",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run format:check && npm run docs:check && npm run lint && npm run typecheck && npm test",
    "config:check": "node scripts/check-config.mjs",
    "speech:check": "node scripts/check-speech-config.mjs",
    "reasoning:check": "node scripts/check-reasoning.mjs",
    "speech:probe": "node --env-file-if-exists=.env.local scripts/gnani-speech-preflight.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
