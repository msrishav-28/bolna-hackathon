# Samvaad: selected direct Speech route. Copy to ignored .env.local.
# Supply provider keys only; code owns Gemini/Groq URLs, default models and labels.
# No private key may use a NEXT_PUBLIC prefix.

# Match the running origin; continuous local review uses port 3013.
APP_ORIGIN=http://127.0.0.1:3013

# Supabase authentication and Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Match Supabase Confirm email OFF (mailer_autoconfirm=true).
# Email ownership is unverified; forgotten-password email recovery is unavailable.
AUTH_EMAIL_VERIFICATION_REQUIRED=false

# Gnani API Platform Speech (Prisma/Timbre v3.0), not Agent Builder
GNANI_SPEECH_API_KEY=
# Owned gateway; loopback WS is local-only. Use WSS behind TLS when hosted.
SAMVAAD_VOICE_WS_URL=ws://127.0.0.1:3015/speech
SPEECH_GATEWAY_PORT=3015
# Managed host: omit SPEECH_GATEWAY_PORT to use its PORT; set host to 0.0.0.0.
# SPEECH_GATEWAY_HOST=0.0.0.0
# Enable only for reviewed testing after all seven migrations and the gateway are ready.
VOICE_RUNTIME_ENABLED=false
# true on Vercel + Render Free: wake the gateway before reserving a round.
VOICE_GATEWAY_WARMUP_ENABLED=false

# Text reasoning: groq selected for testing; gemini is an explicit alternative
REASONING_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=

# Local safeguards; minute limits do not guarantee a currency spending cap
MAX_SESSION_DURATION_SECONDS=300
MAX_DAILY_SESSIONS_PER_USER=10
MAX_MONTHLY_VOICE_MINUTES=30
# Application-generated recovery secret; at least 32 characters
CRON_SECRET=

# Human-owned public contact; never invent this address
PRIVACY_CONTACT_EMAIL=

# Synthetic screen review only; false for public release
UI_PREVIEW_ENABLED=false

# Optional model overrides/custom-provider settings are in the developer guide.
# No Agent Builder IDs, Platform key, webhook or guessed gateway endpoints needed.
# Keep real student rollout gated on the release acceptance checklist.
